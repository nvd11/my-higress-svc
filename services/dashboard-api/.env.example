# ==============================================================================
# Higress Dashboard API 本地开发环境变量示例
# ==============================================================================
# 用法:
#   1. cp .env.example .env
#   2. 按需填写 .env（.env 已被 .gitignore 忽略，绝不提交真实值）
#   3. 启动时自行导出:
#        set -a; source .env; set +a; go run .
#      或使用你习惯的 dotenv 工具。
#
# 安全约定:
#   * 本文件只放占位符，禁止写入真实口令 / Key；
#   * 生产环境由 OCI Vault -> ExternalSecret 注入，不使用本文件；
#   * 仓库级防护见 scripts/secret-scan.py。
# ==============================================================================

# ---------- HTTP ----------
# 默认 4000；兼容旧变量 LITELLM_PORT
PORT=4000
# LITELLM_PORT=4000

# ---------- MySQL (账单明细) ----------
# 生产方向: OCI HeatWave；本地可指向自己的 MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=litellm_user
MYSQL_PASSWORD=
MYSQL_DB=litellm_db

# ---------- Redis (网关本地缓存/计数) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 本地 Redis 未设 requirepass 时留空即可；
# 若设置了密码，必须在此填写，否则连接会报 NOAUTH。
REDIS_PASSWORD=

# ---------- VictoriaLogs ----------
VICTORIALOGS_URL=http://127.0.0.1:9428

# ---------- 汇率 ----------
# 美元折算人民币，用于审计展示
DEFAULT_USD_TO_CNY_RATE=7.2300

# ---------- 上游账单 / 额度 Key (可选，仅相关接口需要) ----------
# A6_API_KEY=
# OPENCODE_GO_API_KEY=
